{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Naum Theme",
  "description": "Semantic light/dark tokens, radius and typography scales, surfaces and reduced-motion styles.",
  "dependencies": [
    "tw-animate-css@1.4.0",
    "shadcn@4.23.0"
  ],
  "cssVars": {
    "theme": {
      "ease-naum": "cubic-bezier(0.22, 1, 0.36, 1)",
      "shadow-naum-card": "var(--naum-shadow-card)",
      "shadow-naum-toast": "var(--naum-shadow-toast)",
      "shadow-naum-glow": "var(--naum-shadow-glow)",
      "shadow-naum-glow-hover": "var(--naum-shadow-glow-hover)",
      "font-sans": "var(\n    --font-naum,\n    \"Plus Jakarta Sans\",\n    ui-sans-serif,\n    system-ui,\n    sans-serif\n  )",
      "font-heading": "var(\n    --font-naum,\n    \"Plus Jakarta Sans\",\n    ui-sans-serif,\n    system-ui,\n    sans-serif\n  )",
      "color-sidebar-ring": "var(--sidebar-ring)",
      "color-sidebar-border": "var(--sidebar-border)",
      "color-sidebar-accent-foreground": "var(--sidebar-accent-foreground)",
      "color-sidebar-accent": "var(--sidebar-accent)",
      "color-sidebar-primary-foreground": "var(--sidebar-primary-foreground)",
      "color-sidebar-primary": "var(--sidebar-primary)",
      "color-sidebar-foreground": "var(--sidebar-foreground)",
      "color-sidebar": "var(--sidebar)",
      "color-chart-5": "var(--chart-5)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-1": "var(--chart-1)",
      "color-ring": "var(--ring)",
      "color-input": "var(--input)",
      "color-border": "var(--border)",
      "color-destructive": "var(--destructive)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-accent": "var(--accent)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-muted": "var(--muted)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-primary": "var(--primary)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-popover": "var(--popover)",
      "color-card-foreground": "var(--card-foreground)",
      "color-card": "var(--card)",
      "color-surface-frosted": "var(--surface-frosted)",
      "color-foreground": "var(--foreground)",
      "color-background": "var(--background)",
      "radius-sm": "calc(var(--radius) * 0.6)",
      "radius-md": "calc(var(--radius) * 0.8)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) * 1.4)",
      "radius-2xl": "calc(var(--radius) * 1.8)",
      "radius-3xl": "calc(var(--radius) * 2.2)",
      "radius-4xl": "calc(var(--radius) * 2.6)"
    },
    "light": {
      "background": "oklch(0.93 0.004 260)",
      "foreground": "oklch(0.14 0.025 262)",
      "card": "oklch(1 0 0 / 92%)",
      "card-foreground": "oklch(0.14 0.025 262)",
      "surface-frosted": "oklch(1 0 0 / 55%)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.145 0 0)",
      "primary": "oklch(0.22 0.03 262)",
      "primary-foreground": "oklch(0.985 0 0)",
      "secondary": "oklch(0.97 0 0)",
      "secondary-foreground": "oklch(0.205 0 0)",
      "muted": "oklch(0.97 0 0)",
      "muted-foreground": "oklch(0.49 0 0)",
      "accent": "oklch(0.97 0 0)",
      "accent-foreground": "oklch(0.205 0 0)",
      "destructive": "oklch(0.5 0.2 27.325)",
      "border": "oklch(0.14 0.025 262 / 6%)",
      "input": "oklch(0.14 0.025 262 / 8%)",
      "ring": "oklch(0.62 0.14 262 / 45%)",
      "chart-1": "oklch(0.62 0.19 262)",
      "chart-2": "oklch(0.68 0.15 190)",
      "chart-3": "oklch(0.66 0.16 150)",
      "chart-4": "oklch(0.74 0.16 70)",
      "chart-5": "oklch(0.66 0.2 350)",
      "radius": "0.625rem",
      "sidebar": "oklch(0.985 0 0)",
      "sidebar-foreground": "oklch(0.145 0 0)",
      "sidebar-primary": "oklch(0.205 0 0)",
      "sidebar-primary-foreground": "oklch(0.985 0 0)",
      "sidebar-accent": "oklch(0.97 0 0)",
      "sidebar-accent-foreground": "oklch(0.205 0 0)",
      "sidebar-border": "oklch(0.922 0 0)",
      "sidebar-ring": "oklch(0.708 0 0)",
      "glass-surface-start": "oklch(1 0 0 / 80%)",
      "glass-surface-end": "oklch(1 0 0 / 45%)",
      "glass-border": "oklch(1 0 0 / 60%)",
      "glass-highlight": "oklch(1 0 0 / 90%)",
      "glass-shadow": "oklch(0.14 0.025 262 / 6%)",
      "glass-blur": "24px",
      "naum-shadow-card": "0 2px 12px -4px oklch(0.14 0.025 262 / 6%)",
      "naum-shadow-toast": "0 12px 32px -8px oklch(0.14 0.025 262 / 14%)",
      "naum-shadow-glow": "0 0 25px rgb(99 102 241 / 40%)",
      "naum-shadow-glow-hover": "0 0 35px rgb(99 102 241 / 60%)",
      "naum-duration-fast": "150ms",
      "naum-duration-normal": "300ms"
    },
    "dark": {
      "background": "oklch(0.14 0.025 262)",
      "foreground": "oklch(1 0 0)",
      "card": "oklch(1 0 0 / 4%)",
      "card-foreground": "oklch(1 0 0)",
      "surface-frosted": "oklch(1 0 0 / 3%)",
      "popover": "oklch(0.205 0 0)",
      "popover-foreground": "oklch(0.985 0 0)",
      "primary": "oklch(0.95 0.01 262)",
      "primary-foreground": "oklch(0.14 0.025 262)",
      "secondary": "oklch(0.269 0 0)",
      "secondary-foreground": "oklch(0.985 0 0)",
      "muted": "oklch(0.269 0 0)",
      "muted-foreground": "oklch(0.708 0 0)",
      "accent": "oklch(0.269 0 0)",
      "accent-foreground": "oklch(0.985 0 0)",
      "destructive": "oklch(0.704 0.191 22.216)",
      "border": "oklch(1 0 0 / 8%)",
      "input": "oklch(1 0 0 / 15%)",
      "ring": "oklch(0.7 0.14 262 / 45%)",
      "chart-1": "oklch(0.68 0.19 262)",
      "chart-2": "oklch(0.74 0.14 195)",
      "chart-3": "oklch(0.72 0.16 155)",
      "chart-4": "oklch(0.78 0.15 75)",
      "chart-5": "oklch(0.72 0.19 345)",
      "sidebar": "oklch(0.205 0 0)",
      "sidebar-foreground": "oklch(0.985 0 0)",
      "sidebar-primary": "oklch(0.488 0.243 264.376)",
      "sidebar-primary-foreground": "oklch(0.985 0 0)",
      "sidebar-accent": "oklch(0.269 0 0)",
      "sidebar-accent-foreground": "oklch(0.985 0 0)",
      "sidebar-border": "oklch(1 0 0 / 10%)",
      "sidebar-ring": "oklch(0.556 0 0)",
      "glass-surface-start": "oklch(1 0 0 / 7%)",
      "glass-surface-end": "oklch(1 0 0 / 1%)",
      "glass-border": "oklch(1 0 0 / 8%)",
      "glass-highlight": "oklch(1 0 0 / 15%)",
      "glass-shadow": "oklch(0 0 0 / 50%)",
      "glass-blur": "24px"
    }
  },
  "css": {
    "@import \"tw-animate-css\"": {},
    "@import \"shadcn/tailwind.css\"": {},
    "@custom-variant dark (&:is(.dark *))": {},
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "body": {
        "@apply bg-background text-foreground": {}
      },
      "html": {
        "@apply font-sans": {}
      },
      "@media (prefers-reduced-motion: reduce)": {
        "*,\n    *::before,\n    *::after": {
          "animation-duration": "0.01ms !important",
          "animation-iteration-count": "1 !important",
          "transition-duration": "0.01ms !important",
          "scroll-behavior": "auto !important"
        }
      }
    },
    "@utility naum-page-title": {
      "font-family": "var(--font-heading)",
      "font-size": "var(--text-4xl)",
      "font-weight": "400",
      "line-height": "1.25",
      "letter-spacing": "-0.025em",
      "@media (width < 48rem)": {
        "font-size": "var(--text-2xl)"
      }
    },
    "@utility naum-glass-card": {
      "background": "linear-gradient(\n    145deg,\n    var(--glass-surface-start) 0%,\n    var(--glass-surface-end) 100%\n  )",
      "backdrop-filter": "blur(var(--glass-blur))",
      "-webkit-backdrop-filter": "blur(var(--glass-blur))",
      "border": "1px solid var(--glass-border)",
      "box-shadow": "inset 0 1px 1px 0 var(--glass-highlight),\n    0 20px 40px -15px var(--glass-shadow)"
    },
    "@utility naum-mesh-lime": {
      "background": "radial-gradient(\n      circle at 85% 90%,\n      oklch(0.84 0.16 95 / 85%),\n      transparent 60%\n    ),\n    linear-gradient(135deg, oklch(0.58 0.12 135) 0%, oklch(0.75 0.15 100) 100%)"
    },
    "@utility naum-mesh-coral": {
      "background": "radial-gradient(\n      circle at 85% 90%,\n      oklch(0.82 0.12 55 / 85%),\n      transparent 60%\n    ),\n    linear-gradient(135deg, oklch(0.66 0.19 25) 0%, oklch(0.77 0.14 48) 100%)"
    },
    "@utility naum-mesh-indigo": {
      "background": "radial-gradient(\n      circle at 85% 85%,\n      oklch(0.82 0.08 220 / 85%),\n      transparent 60%\n    ),\n    linear-gradient(135deg, oklch(0.68 0.13 265) 0%, oklch(0.78 0.11 310) 100%)"
    },
    "@utility naum-mesh-amber": {
      "background": "radial-gradient(\n      circle at 80% 95%,\n      oklch(0.86 0.16 88 / 85%),\n      transparent 58%\n    ),\n    linear-gradient(135deg, oklch(0.75 0.1 65) 0%, oklch(0.78 0.16 78) 100%)"
    },
    "@utility naum-mesh-rose": {
      "background": "radial-gradient(\n      circle at 80% 85%,\n      oklch(0.72 0.2 350 / 85%),\n      transparent 60%\n    ),\n    linear-gradient(135deg, oklch(0.76 0.14 10) 0%, oklch(0.68 0.2 345) 100%)"
    },
    "@utility naum-mesh-mint": {
      "background": "radial-gradient(\n      circle at 85% 90%,\n      oklch(0.84 0.12 145 / 85%),\n      transparent 60%\n    ),\n    linear-gradient(135deg, oklch(0.76 0.09 195) 0%, oklch(0.8 0.12 155) 100%)"
    },
    "@utility naum-popup-surface": {
      "position": "relative",
      "background-color": "var(--popover)",
      "& [data-slot$=\"-item\"]:focus,\n  & [data-slot$=\"-item\"][data-highlighted]": {
        "background-color": "color-mix(in oklch, var(--foreground) 10%, transparent)"
      },
      "& [data-slot$=\"-separator\"]": {
        "background-color": "color-mix(in oklch, var(--foreground) 5%, transparent)"
      }
    },
    "@utility naum-card-lift": {
      "transition": "transform 200ms var(--ease-naum)"
    },
    "@layer components": {
      "@media (prefers-reduced-motion: no-preference)": {
        ".naum-card-lift:hover": {
          "transform": "translateY(-2px)"
        }
      }
    }
  },
  "type": "registry:style"
}
