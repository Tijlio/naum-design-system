{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "bento-insight-card",
  "title": "Naum Bento Insight Card",
  "description": "Naum bento-insight-card for React and Tailwind CSS v4.",
  "dependencies": [
    "lucide-react@1.74.0"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/button.json",
    "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/card.json",
    "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/theme.json"
  ],
  "files": [
    {
      "path": "src/components/bento/insight-card.tsx",
      "type": "registry:component",
      "target": "@components/bento/insight-card.tsx",
      "content": "\"use client\"\n\nimport { ArrowUpRight } from \"lucide-react\"\nimport type { ReactNode } from \"react\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\n\nexport function InsightCard({\n  title = \"Insights\",\n  action,\n  children,\n}: {\n  title?: string\n  action?: ReactNode\n  children?: ReactNode\n}) {\n  return (\n    <Card\n      variant=\"mesh\"\n      className=\"naum-mesh-amber h-full w-full justify-between naum-card-lift\"\n    >\n      <CardHeader>\n        <CardTitle className=\"text-sm font-normal text-white/90\">\n          {title}\n        </CardTitle>\n        <CardAction>\n          {action ?? (\n            <Button variant=\"mesh\" size=\"icon-sm\" aria-label=\"Open Insights\">\n              <ArrowUpRight className=\"size-3.5 transition-transform duration-200 motion-safe:group-hover/card:translate-x-0.5 motion-safe:group-hover/card:-translate-y-0.5\" />\n            </Button>\n          )}\n        </CardAction>\n      </CardHeader>\n\n      <CardContent className=\"flex flex-col gap-5\">\n        <svg\n          aria-hidden=\"true\"\n          viewBox=\"0 0 180 76\"\n          className=\"h-20 w-full stroke-white/65\"\n          fill=\"none\"\n        >\n          <ellipse cx=\"90\" cy=\"38\" rx=\"70\" ry=\"24\" strokeWidth=\"1\" />\n          <ellipse cx=\"90\" cy=\"38\" rx=\"50\" ry=\"17\" strokeWidth=\"1\" />\n          <ellipse cx=\"90\" cy=\"38\" rx=\"30\" ry=\"10\" strokeWidth=\"1\" />\n          <circle cx=\"90\" cy=\"38\" r=\"2.5\" fill=\"white\" />\n        </svg>\n\n        {children ?? (\n          <div className=\"flex flex-col gap-1\">\n            <p className=\"text-xs leading-relaxed text-white/85\">\n              Since yesterday your sales have increased by\n            </p>\n            <p className=\"text-3xl font-normal tracking-tight tabular-nums\">\n              $2,756<span className=\"text-xl text-white/70\">.50</span>\n            </p>\n          </div>\n        )}\n      </CardContent>\n    </Card>\n  )\n}\n"
    }
  ],
  "type": "registry:block"
}
