      "title": "Naum Button",
      "description": "Base UI button with glass & glow variants, cursor-pointer and tactile press.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": [
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/theme.json"
      ],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "command",
      "type": "registry:ui",
      "title": "Naum Command",
      "description": "Command palette with rounded-3xl dialog and balanced padding.",
      "dependencies": ["cmdk", "lucide-react"],
      "registryDependencies": ["dialog", "input-group"],
      "files": [
        {
          "path": "src/components/ui/command.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "sonner",
      "type": "registry:ui",
      "title": "Naum Sonner",
      "description": "Frosted glass toast notifications with high-contrast descriptions.",
      "dependencies": ["sonner", "next-themes", "lucide-react"],
      "files": [
        {
          "path": "src/components/ui/sonner.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "ambient-backdrop",
      "type": "registry:ui",
      "title": "Ambient Backdrop",
      "description": "Soft ambient glow layer behind glass surfaces.",
      "files": [
        {
          "path": "src/components/ui/ambient-backdrop.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "motion",
      "type": "registry:ui",
      "title": "Naum Motion Primitives",
      "description": "Reduced-motion-aware fade, stagger, path draw and layoutId pill primitives.",
      "dependencies": ["motion"],
      "files": [
        {
          "path": "src/components/ui/motion.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "chart",
      "type": "registry:ui",
      "title": "Naum Chart",
      "description": "Recharts wrapper with frosted glass ChartTooltipContent.",
      "dependencies": ["recharts"],
      "files": [
        {
          "path": "src/components/ui/chart.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "all",
      "type": "registry:style",
      "title": "Naum Complete Preset",
      "description": "Installs the complete Naum theme, surfaces, components and motion primitives.",
      "registryDependencies": [
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/theme.json",
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/card.json",
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/button.json",
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/command.json",
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/sonner.json",
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/ambient-backdrop.json",
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/motion.json",
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/chart.json"
      ]
    }
  ]
}
