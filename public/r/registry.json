{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "naum-design-system",
  "homepage": "https://github.com/Tijlio/naum-design-system",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "Naum Theme & Surfaces",
      "description": "OKLCH light & dark tokens, naum-glass-card and naum-mesh-* utilities for Tailwind v4.",
      "dependencies": ["tw-animate-css"],
      "cssVars": {
        "theme": {
          "color-surface-frosted": "var(--surface-frosted)"
        },
        "light": {
          "background": "oklch(0.93 0.004 260)",
          "foreground": "oklch(0.14 0.025 262)",
          "card": "oklch(1 0 0 / 92%)",
          "card-foreground": "oklch(0.14 0.025 262)",
          "surface-frosted": "oklch(1 0 0 / 55%)",
          "primary": "oklch(0.22 0.03 262)",
          "primary-foreground": "oklch(0.985 0 0)",
          "border": "oklch(0.14 0.025 262 / 6%)",
          "input": "oklch(0.14 0.025 262 / 8%)",
          "ring": "oklch(0.62 0.14 262 / 45%)",
          "chart-1": "oklch(0.62 0.19 262)",
          "chart-2": "oklch(0.68 0.15 190)",
          "chart-3": "oklch(0.66 0.16 150)",
          "chart-4": "oklch(0.74 0.16 70)",
          "chart-5": "oklch(0.66 0.2 350)",
          "radius": "0.625rem",
          "glass-surface-start": "oklch(1 0 0 / 80%)",
          "glass-surface-end": "oklch(1 0 0 / 45%)",
          "glass-border": "oklch(1 0 0 / 60%)",
          "glass-highlight": "oklch(1 0 0 / 90%)",
          "glass-shadow": "oklch(0.14 0.025 262 / 6%)",
          "glass-blur": "24px"
        },
        "dark": {
          "background": "oklch(0.14 0.025 262)",
          "foreground": "oklch(1 0 0)",
          "card": "oklch(1 0 0 / 4%)",
          "card-foreground": "oklch(1 0 0)",
          "surface-frosted": "oklch(1 0 0 / 3%)",
          "primary": "oklch(0.95 0.01 262)",
          "primary-foreground": "oklch(0.14 0.025 262)",
          "border": "oklch(1 0 0 / 8%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.7 0.14 262 / 45%)",
          "chart-1": "oklch(0.68 0.19 262)",
          "chart-2": "oklch(0.74 0.14 195)",
          "chart-3": "oklch(0.72 0.16 155)",
          "chart-4": "oklch(0.78 0.15 75)",
          "chart-5": "oklch(0.72 0.19 345)",
          "glass-surface-start": "oklch(1 0 0 / 7%)",
          "glass-surface-end": "oklch(1 0 0 / 1%)",
          "glass-border": "oklch(1 0 0 / 8%)",
          "glass-highlight": "oklch(1 0 0 / 15%)",
          "glass-shadow": "oklch(0 0 0 / 50%)",
          "glass-blur": "24px"
        }
      },
      "css": {
        "@utility naum-glass-card": {
          "background": "linear-gradient(145deg, var(--glass-surface-start) 0%, var(--glass-surface-end) 100%)",
          "backdrop-filter": "blur(var(--glass-blur))",
          "-webkit-backdrop-filter": "blur(var(--glass-blur))",
          "border": "1px solid var(--glass-border)",
          "box-shadow": "inset 0 1px 1px 0 var(--glass-highlight), 0 20px 40px -15px var(--glass-shadow)"
        },
        "@utility naum-mesh-lime": {
          "background": "radial-gradient(circle at 85% 90%, oklch(0.84 0.16 95 / 85%), transparent 60%), linear-gradient(135deg, oklch(0.58 0.12 135) 0%, oklch(0.75 0.15 100) 100%)"
        },
        "@utility naum-mesh-coral": {
          "background": "radial-gradient(circle at 85% 90%, oklch(0.82 0.12 55 / 85%), transparent 60%), linear-gradient(135deg, oklch(0.66 0.19 25) 0%, oklch(0.77 0.14 48) 100%)"
        },
        "@utility naum-mesh-indigo": {
          "background": "radial-gradient(circle at 85% 85%, oklch(0.82 0.08 220 / 85%), transparent 60%), linear-gradient(135deg, oklch(0.68 0.13 265) 0%, oklch(0.78 0.11 310) 100%)"
        },
        "@utility naum-mesh-amber": {
          "background": "radial-gradient(circle at 80% 95%, oklch(0.86 0.16 88 / 85%), transparent 58%), linear-gradient(135deg, oklch(0.75 0.1 65) 0%, oklch(0.78 0.16 78) 100%)"
        },
        "@utility naum-mesh-rose": {
          "background": "radial-gradient(circle at 80% 85%, oklch(0.72 0.2 350 / 85%), transparent 60%), linear-gradient(135deg, oklch(0.76 0.14 10) 0%, oklch(0.68 0.2 345) 100%)"
        },
        "@utility naum-mesh-mint": {
          "background": "radial-gradient(circle at 85% 90%, oklch(0.84 0.12 145 / 85%), transparent 60%), linear-gradient(135deg, oklch(0.76 0.09 195) 0%, oklch(0.8 0.12 155) 100%)"
        }
      }
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Naum Card",
      "description": "Card with default, glass, frosted and mesh variants.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": [
        "https://raw.githubusercontent.com/Tijlio/naum-design-system/main/public/r/theme.json"
      ],
      "files": [
        {
          "path": "src/components/ui/card.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "button",
